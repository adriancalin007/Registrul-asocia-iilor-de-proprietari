// src/app/(dashboard)/layout.tsx
import { auth } from "@/lib/auth";
import { redirect } from "next/navigation";
import { UserRole } from "@prisma/client";
import { cookies } from "next/headers";
import { prisma } from "@/lib/prisma";
import NavItem from "@/components/layout/NavItem";
import TopBar from "@/components/layout/TopBar";
import AssociationSwitcher from "@/components/layout/AssociationSwitcher";
import ChatWidget from "@/components/ChatWidget";
import ProprietarBanner from "@/components/layout/ProprietarBanner";
import { PORTAL_EXTINS } from "@/lib/features";

export default async function DashboardLayout({ children }: { children: React.ReactNode }) {
  const session = await auth();
  if (!session) redirect("/login");

  const role = session.user.role as UserRole;
  const civicType = session.user.civicType ?? "NEIDENTIFICAT";
  const isUAT = role === UserRole.UAT_OPERATOR || role === UserRole.SUPER_ADMIN || role === UserRole.POLICE_OPERATOR;

  // Fetch associations for managers with multiple mandates
  const canSwitch = role === UserRole.MANAGER || role === UserRole.BOARD_PRESIDENT || role === UserRole.AUDITOR;
  let switcherAssociations: { id: string; name: string; neighborhood: string | null }[] = [];
  let activeAssociationId: string | null = null;

  if (canSwitch) {
    const mandates = await prisma.mandate.findMany({
      where: { userId: session.user.id, isActive: true },
      include: { association: { select: { id: true, name: true, neighborhood: true, status: true } } },
      orderBy: { startDate: "desc" },
    });
    switcherAssociations = mandates
      .filter(m => m.association.status === "ACTIVE")
      .map(m => ({ id: m.association.id, name: m.association.name, neighborhood: m.association.neighborhood }));

    const cookieStore = cookies();
    activeAssociationId = cookieStore.get("asociatie_activa")?.value ?? switcherAssociations[0]?.id ?? null;
  }

  // Role categories — used for nav and guard logic
  const isManagement = role === UserRole.MANAGER || role === UserRole.BOARD_PRESIDENT;
  const isFinancialViewer = isManagement || role === UserRole.AUDITOR;

  const isPolice = role === UserRole.POLICE_OPERATOR;

  const uatNav = isPolice
    ? [
        { href: "/uat/sesizari",  labelKey: "nav.sesizari",  icon: "chat" },
      ]
    : [
        { href: "/uat",                       labelKey: "nav.uatPanel",              icon: "institution" },
        { href: "/uat/associations",          labelKey: "nav.associations",           icon: "users" },
        { href: "/uat/managers",              labelKey: "nav.managers",              icon: "users" },
        { href: "/uat/sesizari",              labelKey: "nav.sesizari",              icon: "chat" },
        { href: "/uat/documente-oficiale",    labelKey: "nav.docOficiale",           icon: "document" },
        { href: "/uat/situatii-financiare",   labelKey: "nav.situatiiFinanciare",    icon: "money" },
        { href: "/uat/map",                   labelKey: "nav.map",                   icon: "map" },
        { href: "/uat/import",                labelKey: "nav.import",                icon: "upload" },
        { href: "/uat/reports",               labelKey: "nav.reports",               icon: "dashboard" },
        { href: "/uat/audit",                 labelKey: "nav.auditLog",              icon: "document" },
        ...(role === UserRole.SUPER_ADMIN
          ? [{ href: "/super-admin", labelKey: "nav.superAdmin", icon: "shield" }]
          : []),
      ];

  // Each entry has a `show` condition — filter removes hidden items
  const memberNav = ([
    { href: "/dashboard",  labelKey: "nav.dashboard",    icon: "dashboard",   show: true },
    { href: "/scoli",      labelKey: "nav.schools",       icon: "school",      show: PORTAL_EXTINS && role !== UserRole.SUPPLIER },
    { href: "/documente",  labelKey: "nav.documents",     icon: "document",    show: role !== UserRole.SUPPLIER },
    { href: "/consultari", labelKey: "nav.consultations", icon: "chat",        show: role !== UserRole.SUPPLIER },
    { href: "/adeverinte", labelKey: "nav.certificates",  icon: "certificate", show: isManagement || role === UserRole.OWNER },
    { href: "/avarii",     labelKey: "nav.issues",        icon: "wrench",      show: role !== UserRole.SUPPLIER },
    { href: "/furnizori",  labelKey: "nav.suppliers",     icon: "shop",        show: isManagement || role === UserRole.OWNER || role === UserRole.SUPPLIER },
    { href: "/facturi",    labelKey: "nav.invoices",      icon: "receipt",     show: isManagement },
    { href: "/lucrari",    labelKey: "nav.works",         icon: "hammer",      show: isManagement },
    { href: "/locatari",   labelKey: "nav.residents",     icon: "users",       show: isManagement },
    { href: "/financiare", labelKey: "nav.financials",    icon: "money",       show: isFinancialViewer },
    { href: "/rapoarte",   labelKey: "nav.reports",       icon: "chart",       show: isFinancialViewer },
  ] as const).filter(item => item.show);

  const navItems = isUAT ? uatNav : memberNav;

  return (
    <div className="flex h-screen bg-slate-50 overflow-hidden">
      {/* Sidebar */}
      <aside className="w-60 flex-shrink-0 flex flex-col bg-white border-r border-slate-100/80 print:hidden"
        style={{ boxShadow: "1px 0 0 rgba(0,0,0,0.03)" }}>

        {/* Logo */}
        <div className="h-16 flex items-center gap-3 px-5 border-b border-slate-100/80 flex-shrink-0">
          <div className="w-9 h-9 rounded-2xl flex items-center justify-center flex-shrink-0"
            style={{ background: "linear-gradient(135deg, #4f5fe8 0%, #3040c8 100%)", boxShadow: "0 2px 8px rgba(62,79,200,0.35)" }}>
            <svg className="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75" />
            </svg>
          </div>
          <div className="min-w-0">
            <p className="text-sm font-bold text-slate-900 leading-tight tracking-tight">Sector 1</p>
            <p className="text-xs text-slate-400">Portal Civic</p>
          </div>
        </div>

        {/* Association switcher (managers only) */}
        {canSwitch && switcherAssociations.length > 0 && (
          <div className="px-3 pt-3">
            <AssociationSwitcher
              associations={switcherAssociations}
              activeId={activeAssociationId}
            />
          </div>
        )}

        {/* Nav */}
        <nav className="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">
          {navItems.map(item => (
            <NavItem key={item.href} href={item.href} labelKey={item.labelKey} icon={item.icon} />
          ))}
        </nav>

        {/* Bottom — role & civic type */}
        <div className="px-4 py-4 border-t border-slate-100/80 bg-slate-50/50">
          <div className="flex items-center gap-2">
            <span className="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0" />
            <span className="text-xs font-medium text-slate-500 truncate">
              {role?.replace(/_/g, " ")}
            </span>
          </div>
          {civicType === "CETATEAN_S1" && (
            <div className="mt-1.5 inline-flex items-center gap-1 text-xs text-uat-600 font-semibold bg-uat-50 px-2 py-0.5 rounded-full border border-uat-100">
              <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}>
                <path strokeLinecap="round" strokeLinejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Cetățean S1
            </div>
          )}
          {civicType === "PROPRIETAR" && (
            <div className="mt-1.5 text-xs text-amber-600 font-medium">Proprietar</div>
          )}
        </div>
      </aside>

      {/* Main */}
      <div className="flex-1 flex flex-col min-w-0 overflow-hidden">
        <div className="print:hidden">
          <TopBar user={session.user} />
        </div>

        {PORTAL_EXTINS && civicType === "PROPRIETAR" && (
          <ProprietarBanner />
        )}

        <main className="flex-1 overflow-y-auto">
          <div className="p-6 md:p-8 max-w-screen-xl">
            {children}
          </div>
        </main>
      </div>

      {PORTAL_EXTINS && <ChatWidget userName={session.user.name ?? "Cetățean"} userId={session.user.id} />}
    </div>
  );
}
