// src/app/(dashboard)/asociatia-mea/page.tsx
import { auth } from "@/lib/auth";
import { prisma } from "@/lib/prisma";
import { redirect } from "next/navigation";
import { UserRole } from "@prisma/client";
import { cookies } from "next/headers";
import Link from "next/link";
import type { Metadata } from "next";
import { CLASSIFICATION_LABELS, CLASSIFICATION_BADGE } from "@/lib/scoring";
import type { ScoreClassification } from "@prisma/client";

export const metadata: Metadata = { title: "Asociația mea" };

const MANAGER_ROLES = [UserRole.MANAGER, UserRole.BOARD_PRESIDENT, UserRole.AUDITOR] as UserRole[];

const STATUS_INFO: Record<string, { label: string; badge: string; guidance: string }> = {
  ACTIVE:            { label: "Activă",          badge: "bg-emerald-50 text-emerald-700 border-emerald-200", guidance: "Asociația este activă și conformă cu cerințele UAT Sector 1." },
  PENDING:           { label: "În așteptare",    badge: "bg-amber-50 text-amber-700 border-amber-200",       guidance: "Dosarul a fost depus și urmează să fie preluat de un operator UAT." },
  UNDER_REVIEW:      { label: "În revizie",      badge: "bg-blue-50 text-blue-700 border-blue-200",          guidance: "Dosarul este analizat de un operator UAT. Veți fi notificat la finalizare." },
  NEEDS_COMPLETION:  { label: "Documente lipsă", badge: "bg-orange-50 text-orange-700 border-orange-200",   guidance: "Operatorul UAT a solicitat documente suplimentare. Verificați e-mailul." },
  SUSPENDED:         { label: "Suspendată",      badge: "bg-red-50 text-red-700 border-red-200",             guidance: "Asociația este suspendată. Contactați UAT Sector 1." },
  REJECTED:          { label: "Respinsă",        badge: "bg-slate-100 text-slate-600 border-slate-200",      guidance: "Dosarul a fost respins. Puteți re-depune cu documentele corectate." },
  OFFICIAL_REGISTRY: { label: "Registru oficial", badge: "bg-sky-50 text-sky-700 border-sky-200",           guidance: "Asociația este înregistrată în registrul oficial Sector 1." },
  INACTIVE:          { label: "Inactivă",        badge: "bg-slate-100 text-slate-500 border-slate-200",      guidance: "Asociația este inactivă." },
  DISSOLVED:         { label: "Dizolvată",        badge: "bg-slate-100 text-slate-400 border-slate-200",     guidance: "Asociația a fost dizolvată." },
};

const CLASSIFICATION_GUIDANCE: Record<ScoreClassification, string> = {
  CONFORME:    "Asociația este conformă cu toate cerințele de reglementare.",
  AVERTISMENT: "Există aspecte care necesită îmbunătățire pentru a atinge conformitatea deplină.",
  SOMATIE:     "Sunt necesare acțiuni corective urgente pentru a evita sancțiunile.",
  SANCTIUNE:   "Asociația a primit sancțiune contravențională. Contactați UAT Sector 1.",
};

export default async function AsociatiaMemPage() {
  const session = await auth();
  if (!session) redirect("/login");

  const role = session.user.role as UserRole;
  const isManager = MANAGER_ROLES.includes(role);
  const isOwner   = role === UserRole.OWNER;

  if (!isManager && !isOwner) redirect("/dashboard");

  const cookieStore = cookies();
  const activeId = cookieStore.get("asociatie_activa")?.value ?? null;

  // Fetch association based on role
  let association: {
    id: string; name: string; address: string; rawAddress: string | null;
    neighborhood: string | null; status: string;
    fiscalCode: string | null; registrationYear: number | null;
    scores: {
      id: string; totalPoints: number; maxPossible: number;
      classification: ScoreClassification; calculatedAt: Date;
      isPublic: boolean; hasMissingEliminator: boolean; notes: string | null;
      grid: { versionLabel: string };
    }[];
  } | null = null;

  if (isManager) {
    const mandates = await prisma.mandate.findMany({
      where: { userId: session.user.id, isActive: true },
      include: {
        association: {
          select: {
            id: true, name: true, address: true, rawAddress: true,
            neighborhood: true, status: true, fiscalCode: true, registrationYear: true,
            scores: {
              orderBy: { calculatedAt: "desc" },
              take: 3,
              select: {
                id: true, totalPoints: true, maxPossible: true, classification: true,
                calculatedAt: true, isPublic: true, hasMissingEliminator: true, notes: true,
                grid: { select: { versionLabel: true } },
              },
            },
          },
        },
      },
      orderBy: { startDate: "desc" },
    });
    const candidates = mandates.map(m => m.association);
    association = (activeId ? candidates.find(a => a.id === activeId) : null) ?? candidates[0] ?? null;
  } else {
    // Owner: find via ownership chain
    const ownership = await prisma.ownership.findFirst({
      where: { userId: session.user.id, isActive: true },
      include: {
        unit: {
          include: {
            building: {
              include: {
                association: {
                  select: {
                    id: true, name: true, address: true, rawAddress: true,
                    neighborhood: true, status: true, fiscalCode: true, registrationYear: true,
                    scores: {
                      where: { isPublic: true },
                      orderBy: { calculatedAt: "desc" },
                      take: 3,
                      select: {
                        id: true, totalPoints: true, maxPossible: true, classification: true,
                        calculatedAt: true, isPublic: true, hasMissingEliminator: true, notes: true,
                        grid: { select: { versionLabel: true } },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    });
    association = ownership?.unit.building.association ?? null;
  }

  if (!association) {
    return (
      <div className="max-w-xl mx-auto mt-16 card p-8 text-center">
        <div className="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-4">
          <svg className="w-7 h-7 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75" />
          </svg>
        </div>
        <h2 className="font-semibold text-slate-700 mb-1">Nicio asociație</h2>
        <p className="text-sm text-slate-400">Contul nu este conectat la o asociație. Contactați administratorul.</p>
      </div>
    );
  }

  const statusInfo = STATUS_INFO[association.status] ?? { label: association.status, badge: "bg-slate-100 text-slate-500 border-slate-200", guidance: "" };
  const latestScore = association.scores[0] ?? null;
  const displayAddress = association.rawAddress ?? association.address;

  // Percentile calculation (owners only, for score health comparison)
  let percentileTop: number | null = null;
  let totalScoredAssoc: number | null = null;
  if (latestScore && isOwner) {
    const myPct = latestScore.maxPossible > 0 ? (latestScore.totalPoints / latestScore.maxPossible) * 100 : 0;
    const allPublicScores = await prisma.associationScore.findMany({
      where: { isPublic: true },
      orderBy: { calculatedAt: "desc" },
      select: { associationId: true, totalPoints: true, maxPossible: true },
    });
    // Keep only latest per association
    const latestByAssoc = new Map<string, { totalPoints: number; maxPossible: number }>();
    for (const s of allPublicScores) {
      if (!latestByAssoc.has(s.associationId)) {
        latestByAssoc.set(s.associationId, { totalPoints: s.totalPoints, maxPossible: s.maxPossible });
      }
    }
    totalScoredAssoc = latestByAssoc.size;
    if (totalScoredAssoc > 0) {
      const betterOrEqual = [...latestByAssoc.values()].filter(
        s => s.maxPossible > 0 && (s.totalPoints / s.maxPossible) * 100 >= myPct
      ).length;
      percentileTop = Math.round((betterOrEqual / totalScoredAssoc) * 100);
    }
  }

  const scorePercent = latestScore && latestScore.maxPossible > 0
    ? Math.round((latestScore.totalPoints / latestScore.maxPossible) * 100)
    : null;

  return (
    <div className="max-w-3xl mx-auto space-y-6">
      {/* Header */}
      <div>
        <div className="flex items-start gap-4">
          <div className="w-12 h-12 rounded-2xl bg-uat-50 flex items-center justify-center flex-shrink-0">
            <svg className="w-6 h-6 text-uat-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75" />
            </svg>
          </div>
          <div className="min-w-0 flex-1">
            <h1 className="text-xl font-bold text-slate-900 leading-tight">{association.name}</h1>
            {displayAddress && <p className="text-sm text-slate-400 mt-0.5 truncate">{displayAddress}</p>}
            {association.neighborhood && <p className="text-xs text-slate-300 mt-0.5">📍 {association.neighborhood}</p>}
          </div>
        </div>
      </div>

      {/* Status card */}
      <div className="card card-body space-y-3">
        <div className="flex items-center justify-between">
          <h2 className="font-semibold text-slate-900">Stare dosar</h2>
          <span className={`text-xs px-3 py-1 rounded-full border font-semibold ${statusInfo.badge}`}>
            {statusInfo.label}
          </span>
        </div>
        {statusInfo.guidance && (
          <p className="text-sm text-slate-500">{statusInfo.guidance}</p>
        )}
        {association.status === "NEEDS_COMPLETION" && isManager && (
          <div className="bg-orange-50 border border-orange-200 rounded-xl px-4 py-3 text-sm text-orange-800">
            <p className="font-semibold mb-1">Acțiune necesară</p>
            <p>Verificați notificările prin e-mail și depuneți documentele solicitate de operatorul UAT.</p>
          </div>
        )}
        {association.status === "PENDING" && isManager && (
          <div className="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm text-amber-800">
            <p>Dosarul dvs. este în coadă de așteptare. Nu sunt necesare acțiuni suplimentare în acest moment.</p>
          </div>
        )}
      </div>

      {/* Score section */}
      {latestScore && scorePercent !== null ? (
        <div className="card card-body space-y-4">
          <h2 className="font-semibold text-slate-900">Evaluare conformitate</h2>

          <div className="flex items-center gap-4">
            <span className={`text-sm px-4 py-2 rounded-full border font-semibold ${CLASSIFICATION_BADGE[latestScore.classification]}`}>
              {CLASSIFICATION_LABELS[latestScore.classification]}
            </span>
            <div>
              <p className="text-2xl font-bold text-slate-900">
                {latestScore.totalPoints}
                <span className="text-base font-normal text-slate-400">/{latestScore.maxPossible} pt</span>
                <span className="text-lg font-semibold text-slate-600 ml-2">{scorePercent}%</span>
              </p>
              <p className="text-xs text-slate-400">
                {latestScore.grid.versionLabel} · {new Date(latestScore.calculatedAt).toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" })}
                {latestScore.isPublic && <span className="ml-2 text-emerald-600">· public</span>}
              </p>
            </div>
          </div>

          {/* Progress bar */}
          <div className="space-y-1">
            <div className="w-full bg-slate-100 rounded-full h-2.5">
              <div
                className={`h-2.5 rounded-full transition-all ${
                  latestScore.classification === "CONFORME"    ? "bg-emerald-400" :
                  latestScore.classification === "AVERTISMENT" ? "bg-amber-400"   :
                  latestScore.classification === "SOMATIE"     ? "bg-orange-400"  : "bg-red-400"
                }`}
                style={{ width: `${scorePercent}%` }}
              />
            </div>
            <div className="flex justify-between text-xs text-slate-300">
              <span>0%</span><span>40%</span><span>60%</span><span>80%</span><span>100%</span>
            </div>
          </div>

          {latestScore.hasMissingEliminator && (
            <p className="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
              ⚠ Un criteriu eliminator nu este îndeplinit.
            </p>
          )}

          {/* Guidance */}
          <p className="text-sm text-slate-500">{CLASSIFICATION_GUIDANCE[latestScore.classification]}</p>

          {/* Percentile (owners only) */}
          {isOwner && percentileTop !== null && totalScoredAssoc !== null && totalScoredAssoc > 1 && (
            <div className="bg-sky-50 border border-sky-200 rounded-xl px-4 py-3">
              <p className="text-sm font-semibold text-sky-900 mb-1">Comparație cu alte asociații</p>
              {percentileTop <= 10 ? (
                <p className="text-sm text-sky-700">
                  Asociația dvs. se numără printre cele mai bine evaluate {percentileTop}% din cele {totalScoredAssoc} asociații evaluate public.
                </p>
              ) : percentileTop <= 50 ? (
                <p className="text-sm text-sky-700">
                  Asociația dvs. se situează în jumătatea superioară — top {percentileTop}% din {totalScoredAssoc} asociații evaluate.
                </p>
              ) : (
                <p className="text-sm text-sky-700">
                  Asociația dvs. se situează în percentila {100 - percentileTop} din {totalScoredAssoc} asociații evaluate.
                  Există potențial de îmbunătățire față de alte asociații.
                </p>
              )}
              {/* Simple visual bar */}
              <div className="mt-2 relative w-full bg-sky-100 rounded-full h-2">
                <div className="bg-sky-500 h-2 rounded-full" style={{ width: `${100 - percentileTop}%` }} />
                <div
                  className="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-sky-700 rounded-full border-2 border-white shadow"
                  style={{ left: `calc(${100 - percentileTop}% - 6px)` }}
                />
              </div>
              <div className="flex justify-between text-xs text-sky-400 mt-0.5">
                <span>Mai slab</span><span>Mai bun</span>
              </div>
            </div>
          )}

          {/* Score history */}
          {association.scores.length > 1 && (
            <div className="pt-2 border-t border-slate-100 space-y-1.5">
              <p className="text-xs font-semibold text-slate-400 uppercase tracking-wide">Evaluări anterioare</p>
              {association.scores.slice(1).map(s => {
                const pct = s.maxPossible > 0 ? Math.round((s.totalPoints / s.maxPossible) * 100) : 0;
                return (
                  <div key={s.id} className="flex items-center gap-3 text-sm">
                    <span className={`text-xs px-2 py-0.5 rounded-full border font-medium ${CLASSIFICATION_BADGE[s.classification]}`}>
                      {CLASSIFICATION_LABELS[s.classification]}
                    </span>
                    <span className="text-slate-500">{s.totalPoints}/{s.maxPossible} pt ({pct}%)</span>
                    <span className="text-slate-400 text-xs">{new Date(s.calculatedAt).toLocaleDateString("ro-RO")}</span>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      ) : (
        <div className="card card-body text-center py-8">
          <p className="text-sm text-slate-400">Nicio evaluare de conformitate disponibilă pentru această asociație.</p>
          {isOwner && (
            <p className="text-xs text-slate-300 mt-1">Evaluările sunt efectuate de operatorii UAT Sector 1.</p>
          )}
        </div>
      )}

      {/* Quick links — managers only */}
      {isManager && (
        <div className="card card-body space-y-3">
          <h2 className="font-semibold text-slate-900">Secțiuni</h2>
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {[
              { href: "/documente",           label: "Documente" },
              { href: "/consultari",          label: "Consultări" },
              { href: "/adeverinte",          label: "Adeverințe" },
              { href: "/avarii",              label: "Avarii" },
              { href: "/documente-oficiale",  label: "Acte oficiale" },
              { href: "/situatii-financiare", label: "Situații fin." },
              { href: "/financiare",          label: "Financiar" },
              { href: "/rapoarte",            label: "Rapoarte" },
            ].map(item => (
              <Link
                key={item.href}
                href={item.href}
                className="flex items-center justify-between px-3 py-2.5 rounded-xl border border-slate-200 hover:border-uat-300 hover:bg-uat-50/30 transition-colors text-sm font-medium text-slate-700 hover:text-uat-700"
              >
                {item.label}
                <svg className="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
                  <path strokeLinecap="round" strokeLinejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </Link>
            ))}
          </div>
        </div>
      )}

      {/* Public profile link */}
      {(association.status === "ACTIVE" || association.status === "OFFICIAL_REGISTRY") && (
        <div className="text-center">
          <Link
            href={`/asociatii/${association.id}`}
            className="text-sm text-uat-600 hover:underline"
            target="_blank"
          >
            Profil public al asociației →
          </Link>
        </div>
      )}
    </div>
  );
}
