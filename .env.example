# ============================================================
# BLOC-UAT — variabile de mediu
# Copiază acest fișier în .env.local și completează valorile
# NU comite .env.local în Git niciodată
# ============================================================

# --- Baza de date (PostgreSQL) ---
# Local cu Docker:
DATABASE_URL="postgresql://blocuat:blocuat_pass@localhost:5432/blocuat_db"

# --- NextAuth ---
# Generează cu: openssl rand -base64 32
AUTH_SECRET="u+WriYvilOjjoF78tCeYLQo9uxmSD4ZrkU55Z6SB7+A="
NEXTAUTH_URL="http://localhost:3000"

# --- ROeID (OIDC) --- completezi când ai acces la mediul de test MCID ---
# ROEID_CLIENT_ID=""
# ROEID_CLIENT_SECRET=""
# ROEID_ISSUER="https://auth.roeId.gov.ro"  # URL real la activare

# --- Email (Nodemailer) --- pentru notificări ---
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM="noreply@sector1.ro"

# --- Redis (sesiuni și cache) ---
REDIS_URL="redis://localhost:6379"

# --- Supabase Storage (fișiere / facturi) ---
# Obții din: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — necesar pentru upload server-side (bypass RLS)
# NU expune niciodată în frontend
SUPABASE_SERVICE_ROLE_KEY=""

# --- Claude API (OCR facturi) ---
# Obții cheia de la https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Mediu ---
NODE_ENV="development"

# --- Feature flags ---
# true  → modulele extinse sunt vizibile (scoli, servicii inline, chat AI etc.)
# false → doar modulul de asociații de proprietari
NEXT_PUBLIC_PORTAL_EXTINS=false
